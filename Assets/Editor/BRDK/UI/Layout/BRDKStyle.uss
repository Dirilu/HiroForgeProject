#Root
{
    flex-direction: row;
    flex-grow: 1;
}

#Sidebar
{
    width: 220px;

    background-color: rgb(35,35,35);

    border-right-width:2px;

    border-right-color: rgb(60,60,60);
}

#Content
{
    flex-grow:1;

    background-color: rgb(46,46,46);

    padding-left:20px;
    padding-right:20px;
    padding-top:20px;
}